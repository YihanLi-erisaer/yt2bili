# DeepL API Free key (ends with :fx). Do not commit the real key.
DEEPL_AUTH_KEY=

# Optional: override paths
# BILIUP_BIN=C:\path\to\biliup.exe
# BILI_COOKIES=secrets/bili_cookies.json
# YOUTUBE_COOKIES=secrets/youtube_cookies.txt
# Or read cookies from a logged-in browser (close it first): chrome / edge / firefox
# YOUTUBE_COOKIES_FROM_BROWSER=edge

# Bilibili defaults (biliup default partition = 171 知识·野生技术协会)
# BILI_TID=171
# BILI_TAGS=转载
# Upload CDN line (tx / bda2 / qn / ws). Avoid bldsa on Windows.
BILI_LINE=tx

# Parallel downloads (1-8). Windows default is 1 to avoid WinError 32 on large files.
# DOWNLOAD_JOBS=1
# Seconds to wait between uploads (rate-limit friendly).
# UPLOAD_GAP_SECONDS=30
